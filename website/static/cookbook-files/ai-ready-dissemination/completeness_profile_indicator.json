{
  "name": "indicator profile (starting point)",
  "description": "Fields of the World Bank indicator metadata schema (series_description) that the office requires at each maturity level. Levels are cumulative: ai-ready includes foundational. Edit this file to match the office's own policy; the schema itself requires only idno and name.",
  "levels": {
    "foundational": [
      "idno",
      "name",
      "definition_long",
      "measurement_unit",
      "periodicity",
      "time_periods",
      "geographic_units",
      "sources",
      "date_last_update"
    ],
    "ai-ready": [
      "methodology",
      "universe",
      "series_break",
      "limitation",
      "definition_references",
      "license",
      "citation_requirement",
      "keywords",
      "topics",
      "aliases",
      "languages",
      "contacts"
    ],
    "ai-native": [
      "concepts",
      "related_indicators",
      "api_documentation",
      "links"
    ]
  },
  "vocabularies": {
    "periodicity": [
      "daily",
      "weekly",
      "monthly",
      "quarterly",
      "annual",
      "biennial",
      "every 3 years",
      "every 5 years",
      "irregular"
    ]
  },
  "min_definition_words": 12
}
