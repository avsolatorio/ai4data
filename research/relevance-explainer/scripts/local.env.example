# Copy to scripts/local.env (not committed) and set the paths of this machine. Read by scripts/env.sh.
RELEXP_PY=$HOME/venvs/relexp/bin/python
RELEXP_VLLM=$HOME/venvs/vllm/bin/vllm
RELEXP_LOGS=/path/to/large/disk/relevance-explainer-logs
# Hugging Face cache holding the judge models of synth/models.py (default: ~/.cache/huggingface/hub)
RELEXP_HF_CACHE=/path/to/large/disk/hf_hub
# vllm of the overlay environment for models that the locked transformers cannot load (scripts/vllm_overlay.sh)
RELEXP_VLLM_OVERLAY=/path/to/overlay/bin/vllm
