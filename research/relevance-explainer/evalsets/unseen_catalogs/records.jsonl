{"kind": "opendata", "id": "australia:au-govt-cer-cer-small-scale-instllns-swh-solar-poa-2017-poa2016", "name": "CER - Small-scale Installations - Solar Water Heater - Solar Panel (POA) 2017", "organization": "Government of the Commonwealth of Australia - Clean Energy Regulator", "source": null, "notes": "This dataset presents the footprint of the number of installations of solar water heater (SWH) solar panel systems. The data spans the months of 2017 and includes a total for the year. The data is aggregated to Postal Areas (POAs) from the 2016 Australian Statistical Geography Standard (ASGS). Every month the Clean Energy Regulator (CER) publishes small-scale renewable energy installation data files. These data files provide a list of small generation units (SGU) (small-scale solar panel, wind…", "tags": ["energy"], "formats": ["HTML"], "countries": ["Australia"], "year_start": null, "year_end": null, "frequency": null, "update_frequency": null, "year_label": "years"}
{"kind": "opendata", "id": "zenodo:4454580", "name": "EPSRC HEED Data Repository: Surveys", "organization": "Zenodo", "source": "Elena Gaura; James Brusey; Heaven Crawley; Brandi Jess; Nandor Verba", "notes": "The HEED project aims at understanding energy needs of refugees and displaced populations to improve access to clean energy. The focus of HEED is on the lived experiences of refugees living for protracted periods of time in three refugee camps in Rwanda (Nyabiheke, Gihembe and Kigeme) and internally displaced persons (IDPs) forced to leave their homes as a result of the 2015 earthquake in Nepal. As part of the project, an energy assessment survey of households in both countries was undertaken u…", "tags": ["Surveys", "Humanitarian Energy", "Refugees", "Rwanda", "Nepal"], "formats": ["ZIP"], "countries": ["Nepal", "Rwanda"], "year_start": 2021, "year_end": 2021, "year_label": "publication year", "frequency": null, "update_frequency": null}
